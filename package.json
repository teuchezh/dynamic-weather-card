{
  "name": "dynamic-weather-card",
  "version": "0.5.2",
  "description": "Динамическая карточка погоды для Home Assistant",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun build src/index.ts --outfile=dynamic-weather-card.js --target=browser --format=esm --watch --define __VERSION__='\"dev\"'",
    "lint": "bun run eslint src/",
    "lint:fix": "bun run eslint src/ --fix",
    "prebuild": "bun run locales:generate && bun run locales:check && bun run lint",
    "typecheck": "bun run tsc --noEmit",
    "locales:generate": "bun run scripts/generate-locales.ts",
    "locales:check": "bun run scripts/check-locales.ts"
  },
  "keywords": [
    "home-assistant",
    "homeassistant",
    "lovelace",
    "weather",
    "card",
    "animated"
  ],
  "packageManager": "bun@1.3.6",
  "author": "teuchezh",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/teuchezh/dynamic-weather-card"
  },
  "dependencies": {
    "@bybas/weather-icons": "^2.0.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "eslint-plugin-lit": "^2.3.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
